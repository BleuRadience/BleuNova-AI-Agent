# BleuNova AI Agent Environment Variables
# Copy to .env and fill in values

# General
DEBUG=false

# LLM Backends (Free/Local First)
OLLAMA_MODEL=llama3  # Local model via Ollama

# xAI Grok API (Optional - for wit/humor and advanced reasoning)
GROK_API_KEY=your_xai_api_key_here  # From console.x.ai
GROK_MODEL=grok-beta
WITTY_MODE=false  # Enable for humorous personality

# Integrations (Optional API Keys)
TELEGRAM_TOKEN=your_telegram_bot_token
SERPAPI_KEY=your_serpapi_key  # For web search
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=your_ha_token

# Security/Sandbox
SANDBOX_TIMEOUT=5  # Seconds

# Dashboard Port
DASHBOARD_PORT=8501
